var promise1 = new Promise(function(resolve) {
    var logo = document.querySelector(".logo");
    return logo.addEventListener("click", function() {
        return resolve();
    });
});
var promise2 = new Promise(function(resolve, reject) {
    setTimeout(function() {
        return reject(new Error("Promise rejected after 3s"));
    }, 3000);
});
promise1.then(function() {
    return showMessage("Promise was resolved!", "message");
});
promise2.catch(function() {
    showMessage("Promise was resolved!", "message error-message");
});
function showMessage(text, className) {
    var div = document.createElement("div");
    div.className = className;
    div.textContent = text;
    document.body.append(div);
}

